  "cards": [
    {
      "dot": "cyan",
      "title": "三家客户端，一套事件",
      "items": [
        "create_client() 按 config.protocol 分三支",
        "三家 API 形态完全不同：Messages / Responses / Chat Completions",
        "但都翻译成同一组 7 种 StreamEvent，差异全收敛在 client.py 内"
      ]
    },
    {
      "dot": "violet",
      "title": "归一化做在两处",
      "items": [
        "用量：OpenAI 系的 input_tokens 含缓存 token，减掉 cached 才有可加性",
        "异常：鉴权 / 限流（带 retry_after）/ 网络 / 状态码四类统一成 LLMError 家族",
        "形状：Compat 还要把扁平 schema 重排成 function 嵌套"
      ]
    },
    {
      "dot": "amber",
      "title": "缓存断点打在哪",
      "items": [
        "Anthropic 缓存按前缀命中，断点只打在最长的稳定前缀尾部",
        "三处：system、tools 尾部、最后一条 user 消息尾部",
        "故 tool_result 必须逐字节稳定——由 ContentReplacementState 保证"
      ]
    }
  ]
}
