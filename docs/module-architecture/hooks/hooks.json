  "cards": [
    {
      "dot": "cyan",
      "title": "一个引擎，两种待遇",
      "items": [
        "通知型：run_hooks 跑完把回执塞进队列，工具照常执行",
        "拦截型：只有 pre_tool_use 能 reject，把工具短路成错误结果",
        "配置期就卡死：reject 与 async 只许出现在 pre_tool_use 上"
      ]
    },
    {
      "dot": "violet",
      "title": "条件是自描述的",
      "items": [
        "条件写成 field 运算符 value，共四种：== != =~ ~=",
        "多个条件用 && 或 || 连，但不许混用——混用直接报配置错",
        "字段从 HookContext 取，共三类：tool、event、args.<key>"
      ]
    },
    {
      "dot": "amber",
      "title": "15 个事件，实际只发射 10 个",
      "items": [
        "有调用点：会话与轮次起止、收发前后、工具前后、启动与关闭",
        "从没被发射：error、compact、permission_request 等五个",
        "四种动作里 command / http / prompt 可用，agent 仍是空壳"
      ]
    }
  ]
