  "cards": [
    {
      "dot": "cyan",
      "title": "12 种事件，一串 isinstance",
      "items": [
        "渲染就是 agent.run() 回调里的一串 isinstance，顺序即优先级",
        "12 种全有显式分支、没有 default——新增事件会立刻暴露成未处理",
        "轮次级事件管成组与刷盘，循环级事件管收尾与摘要"
      ]
    },
    {
      "dot": "violet",
      "title": "三处挂起都要等用户",
      "items": [
        "权限：yield 权限请求后 await future，弹窗期间输入框被禁用",
        "提问：AskUserQuestion 不直接 yield，靠工具结果事件旁路触发",
        "计划：循环结束且处于 plan 模式才弹；三处都有 future 竞态守卫"
      ]
    },
    {
      "dot": "amber",
      "title": "渲染件是几件固定小组件",
      "items": [
        "流式文本累积后整段重渲染，不是逐块追加，避免反复重排版",
        "工具块可折叠；同一行够 2 个就合并成摘要行并另起新行",
        "resume 时把历史消息重放成同样的气泡结构"
      ]
    }
  ]
