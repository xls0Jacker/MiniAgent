      {
        "id": "history-path",
        "label": "历史消息路径",
        "focus": [
          "inject_env",
          "inject_ltm",
          "reminder",
          "api_conv"
        ],
        "note": "环境、记忆、提醒都不在 system 里——它们是注入到历史中的 user 消息。"
      },
      {
        "id": "converge",
        "label": "两路汇合",
        "focus": [
          "system",
          "api_conv",
          "stream"
        ],
        "note": "system 走参数，api_conv 走历史，两者在 client.stream() 汇合。"
      },
      {
        "id": "reinject",
        "label": "压缩后重注入",
        "focus": [
          "reinject",
          "inject_env",
          "inject_ltm"
        ],
        "note": "压缩会重写历史、清掉注入，所以压缩后立刻把环境与记忆重新灌一遍。"
      }
    ]
  },
