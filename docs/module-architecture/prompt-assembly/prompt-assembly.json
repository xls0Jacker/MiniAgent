  "cards": [
    {
      "dot": "cyan",
      "title": "两条路径，不是一个",
      "items": [
        "system 参数：内置分段按 priority 0→70 排序拼接，每轮内容固定",
        "历史消息：环境上下文、长程记忆、系统提醒都是注入的 user 消息",
        "两者在 client.stream() 汇合——system 走参数，其余走历史"
      ]
    },
    {
      "dot": "violet",
      "title": "priority 阶梯",
      "items": [
        "Identity 0 → System 10 → DoingTasks 20 → ExecutingActions 30",
        "→ UsingTools 40 → ToneStyle 50 → TextOutput 60 → Environment 70",
        "80 / 90 / 95 留给项目指令、技能、记忆，agent 路径上为空"
      ]
    },
    {
      "dot": "amber",
      "title": "注入为什么要重灌一次",
      "items": [
        "inject_environment 用 insert(0) 插到历史最前，且只插一次",
        "压缩会重写历史，把环境与记忆注入一并清掉",
        "所以 auto_compact 之后代码立刻重新注入环境与记忆"
      ]
    }
  ]
