  "cards": [
    {
      "dot": "cyan",
      "title": "两道防线怎么接力",
      "items": [
        "结果回填是前端门：结果写进历史前就定型，>50k 落盘、>10k 截断",
        "Layer 1 每轮扫一遍：认得出落盘标签就跳过，只做聚合封顶与陈旧裁剪",
        "两者共用同一个 50k 常量与落盘函数——一套机制的两个入口"
      ]
    },
    {
      "dot": "amber",
      "title": "三道护栏（各自独立触发）",
      "items": [
        "轮次上限：iteration > max_iterations（默认 50）即终止",
        "连续未知工具：连 3 次查不到即终止，成功一次即清零",
        "截断恢复：max_tokens 才触发，先升 64k 再续写 3 次"
      ]
    },
    {
      "dot": "rose",
      "title": "工具为什么分两路",
      "items": [
        "依据是工具声明的 is_concurrency_safe，不按读 / 写推断",
        "Todo 属写类却为 True；Bash / EditFile / WriteFile 为 False",
        "并发批走直通路径，不经权限检查器"
      ]
    }
  ]
